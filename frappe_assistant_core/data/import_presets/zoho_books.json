      "Phone": {"from": ["Phone"]},
      "Mobile": {"from": ["MobilePhone", "Mobile Phone"], "fallback": "Phone"},
      "GSTIN": {"from": ["GST Identification Number (GSTIN)", "GSTIN"]},
      "GST Treatment": {"from": ["GST Treatment"], "parse": "map",
