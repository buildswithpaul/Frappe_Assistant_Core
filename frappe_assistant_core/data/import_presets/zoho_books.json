[
  {
    "id": "zoho_books.customers",
    "system": "Zoho Books",
    "source_system": "zoho",
    "export": "Customers (contacts export)",
    "how_to_export": "Sales > Customers > ⋯ > Export Customers (CSV or XLSX).",
    "verified": false,
    "signature": {
      "min_optional": 1,
      "required": [["Display Name"], ["EmailID", "Contact ID", "Customer ID", "GST Treatment", "Billing Address"]],
      "optional": [["Customer Sub Type"], ["Customer ID"], ["Credit Limit"], ["Company Name"], ["Status"]]
    },
    "columns": {
      "Display Name": {"from": ["Display Name"]},
      "Customer ID": {"from": ["Customer ID", "Contact ID"]},
      "Company Name": {"from": ["Company Name"]},
      "Email": {"from": ["EmailID", "Email"]},
      "Phone": {"from": ["Phone"]},
      "Mobile": {"from": ["MobilePhone", "Mobile Phone"], "fallback": "Phone"},
      "GSTIN": {"from": ["GST Identification Number (GSTIN)", "GSTIN"]},
      "GST Treatment": {"from": ["GST Treatment"], "parse": "map",
        "values": {"business_gst": "Registered Regular", "business_registered_regular": "Registered Regular",
                   "business_registered_composition": "Registered Composition", "business_none": "Unregistered",
                   "business_unregistered": "Unregistered", "consumer": "Unregistered", "overseas": "Overseas",
                   "business_sez": "SEZ", "deemed_export": "Deemed Export"}},
      "PAN": {"from": ["PAN Number", "PAN"]},
      "Currency": {"from": ["Currency Code"]},
      "Disabled": {"from": ["Status"], "parse": "map", "default": "0", "values": {"Active": "0", "Inactive": "1"}}
    },
    "targets": [
      {"name": "Customers", "source_key": "Customer ID", "doctype": "Customer",
       "mapping": {"Display Name": "customer_name", "Email": "email_id", "Mobile": "mobile_no", "GSTIN": ["gstin", "tax_id"],
                   "GST Treatment": ["gst_category"], "PAN": ["pan"], "Currency": "default_currency", "Disabled": "disabled"},
       "constants": [{"column": "Customer Type", "field": "customer_type", "value": "Company"}]}
    ]
  },
  {
