# Dependency directories
node_modules/
jspm_packages/

# Frappe build artifacts — bench build auto-creates these inside apps even
# when the app has no bundled assets. public/node_modules is a symlink that
# `node_modules/` doesn't match.
frappe_assistant_core/public/node_modules
frappe_assistant_core/public/dist/

# Vite SPA build output — `bench build` (and `bench get-app` / `bench update`)
# regenerates this from chat/frontend/src/ on every install, so committing it
# bloats diffs with hashed bundle filenames that change every rebuild.
frappe_assistant_core/public/chat/spa/assets/
frappe_assistant_core/public/chat/spa/index.html
frappe_assistant_core/public/chat/spa/.vite/
frappe_assistant_core/chat/frontend/dist/
.vite/

# www/copilot.html is also regenerated by Vite from chat/frontend/index.html.
frappe_assistant_core/www/copilot.html

